# Скопируйте в .env и заполните. Файл .env в git не попадает.

# ── База данных ──────────────────────────────────────────────
# Строка подключения к Postgres (Neon).
# Берётся в панели Neon → Connection string. Обязательно с ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Хранилище файлов (§8.5): Cloudflare R2, S3-совместимое ────
# Фото и документы авто. Браузер в R2 напрямую не ходит — только через
# /api/files/[id] (auth + redaction). На хостинге (Netlify) задать те же значения.
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="motorhof"
S3_ACCESS_KEY_ID="<r2-access-key-id>"
S3_SECRET_ACCESS_KEY="<r2-secret-access-key>"

# ── Аутентификация ───────────────────────────────────────────
# Вход — по личным аккаунтам (таблица User), без общего пароля.
# Создание пользователей: node prisma/seed-users.mjs
# Скрипт печатает временные пароли; при первом входе система требует смену.
